// 07_functions_closures.qk - Conformance test for functions, lambdas, and closures

fn make_adder(x) {
    return fn(y) { return x + y }
}

fn apply_twice(f, x) {
    return f(f(x))
}

fn test_closures() {
    let add5 = make_adder(5)
    let res1 = add5(10)
    if res1 != 15 {
        panic("Closure call failed")
    }

    let add20 = make_adder(20)
    if add20(10) != 30 {
        panic("Second closure call failed")
    }

    let double_it = fn(v) { return v * 2 }
    let res2 = apply_twice(double_it, 3)
    if res2 != 12 {
        panic("Higher order function failed")
    }

    // Capture mutable environment
    let mut counter = 0
    let mut inc = fn() {
        counter = counter + 1
        return counter
    }

    let c1 = inc()
    let c2 = inc()
    let c3 = inc()
    if c1 != 1 or c2 != 2 or c3 != 3 {
        panic("Counter closure failed")
    }
}

test_closures()
println("Functions and closures test passed")
