{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Quokka",
    "scopeName": "source.quokka",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#constructors" },
        { "include": "#functions" },
        { "include": "#operators" },
        { "include": "#variables" }
    ],
    "repository": {
        "comments": {
            "patterns": [{
                "name": "comment.line.double-slash.quokka",
                "match": "//.*$"
            }]
        },
        "strings": {
            "patterns": [{
                "name": "string.quoted.double.quokka",
                "begin": "\"",
                "end": "\"",
                "patterns": [{
                    "name": "constant.character.escape.quokka",
                    "match": "\\\\[nrt\\\\\"0]"
                }, {
                    "name": "variable.other.interpolation.quokka",
                    "begin": "\\{",
                    "end": "\\}",
                    "patterns": [{ "include": "source.quokka" }]
                }]
            }]
        },
        "numbers": {
            "patterns": [{
                "name": "constant.numeric.float.quokka",
                "match": "\\b[0-9]+\\.[0-9]+\\b"
            }, {
                "name": "constant.numeric.integer.quokka",
                "match": "\\b[0-9]+\\b"
            }]
        },
        "keywords": {
            "patterns": [{
                "name": "keyword.control.quokka",
                "match": "\\b(if|else|match|while|for|in|return|break|continue)\\b"
            }, {
                "name": "keyword.declaration.quokka",
                "match": "\\b(let|mut|shadow|fn|struct|trait|impl)\\b"
            }, {
                "name": "keyword.operator.logical.quokka",
                "match": "\\b(and|or|not)\\b"
            }, {
                "name": "constant.language.boolean.quokka",
                "match": "\\b(true|false)\\b"
            }]
        },
        "types": {
            "patterns": [{
                "name": "support.type.quokka",
                "match": "\\b(Int|Float|Bool|String|Option|Result|List|Function|Unit)\\b"
            }]
        },
        "constructors": {
            "patterns": [{
                "name": "entity.name.tag.quokka",
                "match": "\\b(Some|None|Ok|Err)\\b"
            }]
        },
        "functions": {
            "patterns": [{
                "name": "entity.name.function.quokka",
                "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
            }, {
                "name": "entity.name.function.definition.quokka",
                "match": "(?<=fn\\s)[a-zA-Z_][a-zA-Z0-9_]*"
            }]
        },
        "operators": {
            "patterns": [{
                "name": "keyword.operator.quokka",
                "match": "(\\+\\+|->|=>|==|!=|<=|>=|\\?|[+\\-*/%<>=])"
            }]
        },
        "variables": {
            "patterns": [{
                "name": "variable.other.quokka",
                "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
            }]
        }
    }
}
