// joey.qk
// Joey ML extension for Quokka with ATSRS support

struct JoeyPipeline {
    config
}

fn joey_pipeline() {
    return JoeyPipeline([])
}

fn joey_load_model(pipe, model_name, quantization) {
    push(pipe.config, ["load_model", model_name, quantization])
    return Ok(true)
}

fn joey_qlora(pipe, r, lora_alpha, dropout) {
    push(pipe.config, ["qlora", r, lora_alpha, dropout])
    return Ok(true)
}

fn joey_atsrs(pipe, ram_budget_gb, nvme_path, min_tokens_per_step) {
    push(pipe.config, ["atsrs", ram_budget_gb, nvme_path, min_tokens_per_step])
    return Ok(true)
}

fn joey_dataset(pipe, name, max_seq_length) {
    push(pipe.config, ["dataset", name, max_seq_length])
    return Ok(true)
}

fn joey_train(pipe, epochs, learning_rate, batch_size, grad_accum) {
    push(pipe.config, ["train", epochs, learning_rate, batch_size, grad_accum])
    return Ok(true)
}

fn joey_save(pipe, path) {
    push(pipe.config, ["save", path])
    return Ok(true)
}

fn joey_run(pipe) {
    let mut json = "["
    let mut i = 0
    let config = pipe.config
    while i < len(config) {
        let cmd = config[i]
        json = json ++ "{\"" ++ cmd[0] ++ "\": ["
        let mut j = 1
        while j < len(cmd) {
            json = json ++ "\"" ++ to_string(cmd[j]) ++ "\""
            if j < len(cmd) - 1 { json = json ++ ", " }
            j = j + 1
        }
        json = json ++ "]}"
        if i < len(config) - 1 { json = json ++ ", " }
        i = i + 1
    }
    json = json ++ "]"

    let write_res = file_write(".joey_job.json", json)
    match write_res {
        Ok(v) => {
            let use_native = true
            let mut result = Ok(false)
            if use_native {
                result = joey_run_native(".joey_job.json")
            } else {
                let mut py = "python3"
                if os_name() == "windows" { py = "python" }
                result = exec([py, "src/std/joey_backend.py", ".joey_job.json"])
            }
            match result {
                Ok(res) => {
                    let status = res[0][1]
                    let out = res[1][1]
                    println(out)
                    if status == 0 {
                        return Ok(true)
                    } else {
                        return Err("Joey backend failed with status " ++ to_string(status))
                    }
                },
                Err(e) => return Err("Failed to launch Joey backend: " ++ e)
            }
        },
        Err(e) => return Err("Failed to write job config: " ++ e)
    }
}
