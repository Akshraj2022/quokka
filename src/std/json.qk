// Quokka Standard Library: json.qk
// Pure Quokka JSON Parser and Serializer

struct JsonParser { src, len, pos }
struct JsonObject { keys, values }

fn json_object_new() {
    return JsonObject([], [])
}

fn json_object_set(obj, key, val) {
    let mut i = 0
    let n = len(obj.keys)
    while i < n {
        if obj.keys[i] == key {
            list_set(obj.values, i, val)
            return
        }
        i = i + 1
    }
    push(obj.keys, key)
    push(obj.values, val)
}

fn json_object_get(obj, key) {
    let mut i = 0
    let n = len(obj.keys)
    while i < n {
        if obj.keys[i] == key {
            return Some(obj.values[i])
        }
        i = i + 1
    }
    return None
}

// --- Serializer ---

fn json_escape_string(s) {
    let mut out = ""
    let n = len(s)
    let mut i = 0
    while i < n {
        let ch = substring(s, i, i + 1)
        if ch == "\"" {
            out = out ++ "\\\""
        } else if ch == "\\" {
            out = out ++ "\\\\"
        } else if ch == "\n" {
            out = out ++ "\\n"
        } else if ch == "\r" {
            out = out ++ "\\r"
        } else if ch == "\t" {
            out = out ++ "\\t"
        } else {
            out = out ++ ch
        }
        i = i + 1
    }
    return out
}

fn json_stringify(val) {
    let t = type_of(val)
    if t == "Int" or t == "Float" {
        return to_string(val)
    }
    if t == "Bool" {
        return if val { "true" } else { "false" }
    }
    if t == "String" {
        return "\"" ++ json_escape_string(val) ++ "\""
    }
    if t == "Unit" or t == "None" {
        return "null"
    }
    if t == "Option" {
        return match val {
            Some(v) => json_stringify(v),
            None    => "null",
        }
    }
    if t == "Result" {
        return match val {
            Ok(v)  => "{\"ok\":" ++ json_stringify(v) ++ "}",
            Err(e) => "{\"error\":" ++ json_stringify(e) ++ "}",
        }
    }
    if t == "List" {
        let mut out = "["
        let n = len(val)
        let mut i = 0
        while i < n {
            if i > 0 { out = out ++ "," }
            out = out ++ json_stringify(val[i])
            i = i + 1
        }
        return out ++ "]"
    }
    if t == "JsonObject" or t == "Struct" {
        let mut out = "{"
        let keys = val.keys
        let values = val.values
        let n = len(keys)
        let mut i = 0
        while i < n {
            if i > 0 { out = out ++ "," }
            out = out ++ "\"" ++ json_escape_string(keys[i]) ++ "\":" ++ json_stringify(values[i])
            i = i + 1
        }
        return out ++ "}"
    }
    return to_string(val)
}

// --- Parser ---

fn json_skip_whitespace(p) {
    while p.pos < p.len {
        let ch = substring(p.src, p.pos, p.pos + 1)
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r" {
            p.pos = p.pos + 1
        } else {
            return
        }
    }
}

fn json_peek(p) {
    json_skip_whitespace(p)
    if p.pos >= p.len { return "" }
    return substring(p.src, p.pos, p.pos + 1)
}

fn json_parse_string(p) {
    p.pos = p.pos + 1 // skip open quote
    let mut out = ""
    while p.pos < p.len {
        let ch = substring(p.src, p.pos, p.pos + 1)
        if ch == "\"" {
            p.pos = p.pos + 1
            return Ok(out)
        }
        if ch == "\\" {
            p.pos = p.pos + 1
            if p.pos >= p.len { return Err("Unexpected EOF in string escape") }
            let esc = substring(p.src, p.pos, p.pos + 1)
            if esc == "\"" { out = out ++ "\"" }
            else if esc == "\\" { out = out ++ "\\" }
            else if esc == "n" { out = out ++ "\n" }
            else if esc == "r" { out = out ++ "\r" }
            else if esc == "t" { out = out ++ "\t" }
            else { out = out ++ esc }
        } else {
            out = out ++ ch
        }
        p.pos = p.pos + 1
    }
    return Err("Unterminated string literal")
}

fn json_parse_number(p) {
    let start = p.pos
    let mut has_dot = false
    let ch0 = substring(p.src, p.pos, p.pos + 1)
    if ch0 == "-" { p.pos = p.pos + 1 }
    while p.pos < p.len {
        let ch = substring(p.src, p.pos, p.pos + 1)
        if ch == "." {
            has_dot = true
            p.pos = p.pos + 1
        } else if ch >= "0" and ch <= "9" {
            p.pos = p.pos + 1
        } else {
            break
        }
    }
    let num_str = substring(p.src, start, p.pos)
    if has_dot {
        return to_float(num_str)
    }
    return to_int(num_str)
}

fn json_parse_array(p) {
    p.pos = p.pos + 1 // skip '['
    let mut items = []
    json_skip_whitespace(p)
    if json_peek(p) == "]" {
        p.pos = p.pos + 1
        return Ok(items)
    }
    while p.pos < p.len {
        let item_res = json_parse_value(p)
        match item_res {
            Ok(item) => push(items, item),
            Err(e)   => return Err(e),
        }
        json_skip_whitespace(p)
        let ch = json_peek(p)
        if ch == "," {
            p.pos = p.pos + 1
        } else if ch == "]" {
            p.pos = p.pos + 1
            return Ok(items)
        } else {
            return Err("Expected ',' or ']' in array")
        }
    }
    return Err("Unterminated array")
}

fn json_parse_object(p) {
    p.pos = p.pos + 1 // skip '{'
    let obj = json_object_new()
    json_skip_whitespace(p)
    if json_peek(p) == "}" {
        p.pos = p.pos + 1
        return Ok(obj)
    }
    while p.pos < p.len {
        json_skip_whitespace(p)
        if json_peek(p) != "\"" {
            return Err("Expected string key in object")
        }
        let key_res = json_parse_string(p)
        let key = match key_res {
            Ok(k)  => k,
            Err(e) => return Err(e),
        }
        json_skip_whitespace(p)
        if json_peek(p) != ":" {
            return Err("Expected ':' after key in object")
        }
        p.pos = p.pos + 1 // skip ':'
        let val_res = json_parse_value(p)
        let val = match val_res {
            Ok(v)  => v,
            Err(e) => return Err(e),
        }
        json_object_set(obj, key, val)
        json_skip_whitespace(p)
        let ch = json_peek(p)
        if ch == "," {
            p.pos = p.pos + 1
        } else if ch == "}" {
            p.pos = p.pos + 1
            return Ok(obj)
        } else {
            return Err("Expected ',' or '}' in object")
        }
    }
    return Err("Unterminated object")
}

fn json_parse_value(p) {
    json_skip_whitespace(p)
    if p.pos >= p.len {
        return Err("Unexpected EOF while parsing JSON")
    }
    let ch = substring(p.src, p.pos, p.pos + 1)
    if ch == "\"" {
        return json_parse_string(p)
    }
    if ch == "[" {
        return json_parse_array(p)
    }
    if ch == "{" {
        return json_parse_object(p)
    }
    if (ch >= "0" and ch <= "9") or ch == "-" {
        return json_parse_number(p)
    }
    if ch == "t" and substring(p.src, p.pos, p.pos + 4) == "true" {
        p.pos = p.pos + 4
        return Ok(true)
    }
    if ch == "f" and substring(p.src, p.pos, p.pos + 5) == "false" {
        p.pos = p.pos + 5
        return Ok(false)
    }
    if ch == "n" and substring(p.src, p.pos, p.pos + 4) == "null" {
        p.pos = p.pos + 4
        return Ok(None)
    }
    return Err("Unexpected token in JSON at position " ++ to_string(p.pos))
}

fn json_parse(src) {
    let p = JsonParser(src, len(src), 0)
    let res = json_parse_value(p)
    return res
}
