// ast.qk - Defines AST nodes as Lists: [type_string, ...fields]

fn node_int(val) { return ["Int", val] }
fn node_float(val) { return ["Float", val] }
fn node_bool(val) { return ["Bool", val] }
fn node_string(val) { return ["String", val] }
fn node_ident(name) { return ["Ident", name] }

fn node_let(name, is_mut, value) { return ["Let", name, is_mut, value] }
fn node_shadow(name, value) { return ["Shadow", name, value] }
fn node_assign(name, value) { return ["Assign", name, value] }

fn node_binary(op, left, right) { return ["Binary", op, left, right] }
fn node_unary(op, operand) { return ["Unary", op, operand] }

fn node_if(cond, then_b, else_b) { return ["If", cond, then_b, else_b] }
fn node_while(cond, body) { return ["While", cond, body] }

fn node_fn(name, params, body) { return ["Fn", name, params, body] }
fn node_call(callee, args) { return ["Call", callee, args] }

fn node_block(stmts) { return ["Block", stmts] }
fn node_return(val) { return ["Return", val] }
fn node_program(stmts) { return ["Program", stmts] }

// New features
fn node_list(elements) { return ["ListLit", elements] }
fn node_index(array, idx) { return ["Index", array, idx] }

// errors.qk

fn parse_error(line, msg) {
    println("[line " ++ to_string(line) ++ "] Parse Error: " ++ msg)
}

fn runtime_error(line, msg) {
    println("[line " ++ to_string(line) ++ "] Runtime Error: " ++ msg)
}

// values.qk

// Since values in our self-hosted interpreter can just map to 
// the underlying stage-0 interpreter values (like Int, String, List),
// we don't need complex wrappers for primitives.

// However, for Functions, we need to represent them explicitly.
fn val_fn(name, params, body, closure_env) {
    let mut captured = closure_env
    if name == "" { captured = env_clone(closure_env) }
    return ["FnVal", name, params, body, captured]
}

fn val_builtin(name, arity) {
    return ["Builtin", name, arity]
}

// environment.qk

fn env_new(parent) {
    return [parent, []]
}

fn env_clone(env) {
    if type_of(env) != "List" or len(env) != 2 { return env }
    let parent_clone = env_clone(env[0])
    let bindings = env[1]
    let mut new_bindings = []
    let mut i = 0
    let l = len(bindings)
    while i < l {
        let b = bindings[i]
        push(new_bindings, [b[0], b[1], b[2]])
        i = i + 1
    }
    return [parent_clone, new_bindings]
}

fn env_define(env, name, value, is_mut) {
    let bindings = env[1]
    let mut i = 0
    let l = len(bindings)
    while i < l {
        let b = bindings[i]
        if b[0] == name {
            list_set(b, 1, value)
            list_set(b, 2, is_mut)
            return true
        }
        i = i + 1
    }
    push(bindings, [name, value, is_mut])
    return true
}

fn env_get(env, name) {
    let mut curr = env
    while type_of(curr) == "List" and len(curr) == 2 {
        let bindings = curr[1]
        let mut i = 0
        let l = len(bindings)
        while i < l {
            let b = bindings[i]
            if b[0] == name {
                return Ok(b[1])
            }
            i = i + 1
        }
        curr = curr[0]
    }
    return Err("Undefined variable")
}

fn env_set(env, name, value) {
    let mut curr = env
    while type_of(curr) == "List" and len(curr) == 2 {
        let bindings = curr[1]
        let mut i = 0
        let l = len(bindings)
        while i < l {
            let b = bindings[i]
            if b[0] == name {
                if b[2] == false {
                    return Err("Cannot mutate immutable variable")
                }
                list_set(b, 1, value)
                return Ok(true)
            }
            i = i + 1
        }
        curr = curr[0]
    }
    return Err("Undefined variable")
}

// lexer.qk
// Lexer outputs a list of tokens: [type_string, literal_value, line]

fn is_alpha(c) {
    let alpha = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
    let mut i = 0
    let l = len(alpha)
    while i < l {
        if substring(alpha, i, i + 1) == c { return true }
        i = i + 1
    }
    return false
}

fn is_digit(c) {
    let digits = "0123456789"
    let mut i = 0
    let l = len(digits)
    while i < l {
        if substring(digits, i, i + 1) == c { return true }
        i = i + 1
    }
    return false
}

fn is_alnum(c) {
    return is_alpha(c) or is_digit(c)
}

fn lex(source) {
    let mut tokens = []
    let mut i = 0
    let mut line = 1
    let srclen = len(source)
    
    while i < srclen {
        let c = source[i]
        
        let nl_str = "
"
        let mut newline = substring(nl_str, 0, 1)
        if len(nl_str) == 2 { newline = substring(nl_str, 1, 2) }
        let space = " 	
"
        let mut is_space = false
        let mut k = 0
        while k < len(space) {
            if c == substring(space, k, k+1) { is_space = true }
            k = k + 1
        }
        
        if is_space {
            if c == newline { line = line + 1 }
            i = i + 1
        } else if c == "/" and i + 1 < srclen and source[i+1] == "/" {
            while i < srclen and source[i] != newline {
                i = i + 1
            }
        } else if is_alpha(c) {
            let mut start = i
            while i < srclen and is_alnum(source[i]) {
                i = i + 1
            }
            let word = substring(source, start, i)
            let mut type = "IDENT"
            if word == "let" { type = "LET" }
            else if word == "mut" { type = "MUT" }
            else if word == "shadow" { type = "SHADOW" }
            else if word == "fn" { type = "FN" }
            else if word == "return" { type = "RETURN" }
            else if word == "if" { type = "IF" }
            else if word == "else" { type = "ELSE" }
            else if word == "while" { type = "WHILE" }
            else if word == "for" { type = "FOR" }
            else if word == "in" { type = "IN" }
            else if word == "break" { type = "BREAK" }
            else if word == "continue" { type = "CONTINUE" }
            else if word == "true" { type = "TRUE" }
            else if word == "false" { type = "FALSE" }
            else if word == "and" { type = "AND" }
            else if word == "or" { type = "OR" }
            else if word == "not" { type = "NOT" }
            else if word == "Some" { type = "SOME" }
            else if word == "None" { type = "NONE" }
            else if word == "Ok" { type = "OK" }
            else if word == "Err" { type = "ERR" }
            else if word == "match" { type = "MATCH" }
            push(tokens, [type, word, line])
        } else if is_digit(c) {
            let mut start = i
            let mut is_float = false
            while i < srclen and (is_digit(source[i]) or source[i] == ".") {
                if source[i] == "." { is_float = true }
                i = i + 1
            }
            let word = substring(source, start, i)
            if is_float {
                // Actually to_float doesn't exist? C host might not have it!
                // Let's just push it as FLOAT. Wait, C host evaluator expects float_val for Float. 
                // Wait, if there is no to_float, how to parse float? Quokka interpreter didn't have float literals anyway, we'll just push string for now, but evaluator needs to know!
                let fval = match to_float(word) { Ok(v) => v, Err(e) => 0.0 }
                push(tokens, ["FLOAT", fval, line])
            } else {
                push(tokens, ["INT", unwrap_or(to_int(word), 0), line])
            }
        } else if c == substring("\"\"", 1, 2) {
            i = i + 1
            let mut start = i
            while i < srclen and source[i] != substring("\"\"", 1, 2) {
                if source[i] == substring("\"\"", 0, 1) and i + 1 < srclen {
                    i = i + 1 // skip escaped char
                }
                i = i + 1
            }
            let word = substring(source, start, i)
            i = i + 1
            push(tokens, ["STRING", word, line])
        } else {
            let mut next = ""
            if i + 1 < srclen { next = source[i+1] }
            
            if c == "+" and next == "+" { push(tokens, ["CONCAT", "++", line]) i = i + 2 }
            else if c == "=" and next == "=" { push(tokens, ["EQ", "==", line]) i = i + 2 }
            else if c == "!" and next == "=" { push(tokens, ["NEQ", "!=", line]) i = i + 2 }
            else if c == "<" and next == "=" { push(tokens, ["LEQ", "<=", line]) i = i + 2 }
            else if c == ">" and next == "=" { push(tokens, ["GEQ", ">=", line]) i = i + 2 }
            else if c == "=" and next == ">" { push(tokens, ["FAT_ARROW", "=>", line]) i = i + 2 }
            else if c == "-" and next == ">" { push(tokens, ["ARROW", "->", line]) i = i + 2 }
            else {
                let mut type = "UNKNOWN"
                if c == "+" { type = "PLUS" }
                else if c == "-" { type = "MINUS" }
                else if c == "*" { type = "STAR" }
                else if c == "/" { type = "SLASH" }
                else if c == "%" { type = "PERCENT" }
                else if c == "=" { type = "ASSIGN" }
                else if c == "<" { type = "LT" }
                else if c == ">" { type = "GT" }
                else if c == "(" { type = "LPAREN" }
                else if c == ")" { type = "RPAREN" }
                else if c == "{" { type = "LBRACE" }
                else if c == "}" { type = "RBRACE" }
                else if c == "[" { type = "LBRACKET" }
                else if c == "]" { type = "RBRACKET" }
                else if c == "," { type = "COMMA" }
                else if c == "?" { type = "QUESTION" }
                else if c == ":" { type = "COLON" }
                else if c == "_" { type = "UNDERSCORE" }
                push(tokens, [type, c, line])
                i = i + 1
            }
        }
    }
    push(tokens, ["EOF", "", line])
    return tokens
}


// parser.qk
fn make_parser(tokens) { return [tokens, 0, false] }
fn parse(p) {
    let mut stmts = []
    while p[1] < len(p[0]) and p[0][p[1]][0] != "EOF" {
        push(stmts, statement(p))
    }
    return ["Program", stmts]
}
fn advance(p) { list_set(p, 1, p[1] + 1) }
fn peek(p) { if p[1] < len(p[0]) { return p[0][p[1]] } return ["EOF", "", 0] }
fn check(p, type) { return peek(p)[0] == type }
fn match_tok(p, type) { if check(p, type) { advance(p) return true } return false }
fn consume(p, type) {
    if check(p, type) { advance(p) return true }
    println("Parse error: expected " ++ type)
    list_set(p, 2, true)
    return false
}

fn statement(p) {
    if match_tok(p, "LET") {
        let is_mut = match_tok(p, "MUT")
        let name = peek(p)[1]
        consume(p, "IDENT")
        consume(p, "ASSIGN")
        return ["Let", name, is_mut, expression(p)]
    }
    if match_tok(p, "SHADOW") {
        let name = peek(p)[1]
        consume(p, "IDENT")
        consume(p, "ASSIGN")
        return ["Shadow", name, expression(p)]
    }
    if match_tok(p, "FN") {
        let mut name = ""
        if check(p, "IDENT") { name = peek(p)[1] advance(p) }
        consume(p, "LPAREN")
        let mut params = []
        if not check(p, "RPAREN") {
            let p1 = peek(p)[1]
            consume(p, "IDENT")
            if match_tok(p, "COLON") { consume(p, "IDENT") }
            push(params, p1)
            while match_tok(p, "COMMA") {
                let p2 = peek(p)[1]
                consume(p, "IDENT")
                if match_tok(p, "COLON") { consume(p, "IDENT") }
                push(params, p2)
            }
        }
        consume(p, "RPAREN")
        if match_tok(p, "ARROW") { consume(p, "IDENT") }
        return ["Fn", name, params, parse_block(p)]
    }
    if match_tok(p, "RETURN") {
        let mut val = ["None"]
        let pt = peek(p)[0]
        if pt=="INT" or pt=="STRING" or pt=="TRUE" or pt=="FALSE" or pt=="IDENT" or pt=="NONE" or pt=="SOME" or pt=="OK" or pt=="ERR" or pt=="LPAREN" or pt=="MINUS" or pt=="NOT" or pt=="LBRACKET" or pt=="IF" or pt=="MATCH" or pt=="FN" {
            val = expression(p)
        }
        return ["Return", val]
    }
    if match_tok(p, "WHILE") { return ["While", expression(p), parse_block(p)] }
    if match_tok(p, "FOR") {
        let var_name = peek(p)[1]
        consume(p, "IDENT")
        consume(p, "IN")
        let iter = expression(p)
        return ["For", var_name, iter, parse_block(p)]
    }
    if match_tok(p, "BREAK") { return ["Break"] }
    if match_tok(p, "CONTINUE") { return ["Continue"] }
    
    return expression(p)
}

fn parse_block(p) {
    consume(p, "LBRACE")
    let mut stmts = []
    while not check(p, "RBRACE") and not check(p, "EOF") { push(stmts, statement(p)) }
    consume(p, "RBRACE")
    return ["Block", stmts]
}

fn expression(p) { return parse_assignment(p) }
fn parse_assignment(p) {
    let expr = parse_logic_or(p)
    if match_tok(p, "ASSIGN") {
        if expr[0] == "Ident" { return ["Assign", expr[1], parse_assignment(p)] }
        list_set(p, 2, true)
    }
    return expr
}
fn parse_logic_or(p) {
    let mut expr = parse_logic_and(p)
    while match_tok(p, "OR") { expr = ["Binary", "or", expr, parse_logic_and(p)] }
    return expr
}
fn parse_logic_and(p) {
    let mut expr = parse_equality(p)
    while match_tok(p, "AND") { expr = ["Binary", "and", expr, parse_equality(p)] }
    return expr
}
fn parse_equality(p) {
    let mut expr = parse_comparison(p)
    while true {
        if match_tok(p, "EQ") { expr = ["Binary", "==", expr, parse_comparison(p)] }
        else if match_tok(p, "NEQ") { expr = ["Binary", "!=", expr, parse_comparison(p)] }
        else { return expr }
    }
}
fn parse_comparison(p) {
    let mut expr = parse_term(p)
    while true {
        if match_tok(p, "LT") { expr = ["Binary", "<", expr, parse_term(p)] }
        else if match_tok(p, "GT") { expr = ["Binary", ">", expr, parse_term(p)] }
        else if match_tok(p, "LEQ") { expr = ["Binary", "<=", expr, parse_term(p)] }
        else if match_tok(p, "GEQ") { expr = ["Binary", ">=", expr, parse_term(p)] }
        else { return expr }
    }
}
fn parse_term(p) {
    let mut expr = parse_factor(p)
    while true {
        if match_tok(p, "PLUS") { expr = ["Binary", "+", expr, parse_factor(p)] }
        else if match_tok(p, "MINUS") { expr = ["Binary", "-", expr, parse_factor(p)] }
        else if match_tok(p, "CONCAT") { expr = ["Binary", "++", expr, parse_factor(p)] }
        else { return expr }
    }
}
fn parse_factor(p) {
    let mut expr = parse_unary(p)
    while true {
        if match_tok(p, "STAR") { expr = ["Binary", "*", expr, parse_unary(p)] }
        else if match_tok(p, "SLASH") { expr = ["Binary", "/", expr, parse_unary(p)] }
        else if match_tok(p, "PERCENT") { expr = ["Binary", "%", expr, parse_unary(p)] }
        else { return expr }
    }
}
fn parse_unary(p) {
    if match_tok(p, "NOT") { return ["Unary", "not", parse_unary(p)] }
    if match_tok(p, "MINUS") { return ["Unary", "-", parse_unary(p)] }
    return parse_call(p)
}
fn parse_call(p) {
    let mut expr = parse_primary(p)
    while true {
        if match_tok(p, "LPAREN") {
            let mut args = []
            if not check(p, "RPAREN") {
                push(args, expression(p))
                while match_tok(p, "COMMA") { push(args, expression(p)) }
            }
            consume(p, "RPAREN")
            expr = ["Call", expr, args]
        } else if match_tok(p, "LBRACKET") {
            let idx = expression(p)
            consume(p, "RBRACKET")
            expr = ["Index", expr, idx]
        } else if match_tok(p, "QUESTION") {
            expr = ["Unwrap", expr]
        } else {
            return expr
        }
    }
}
fn parse_primary(p) {
    if match_tok(p, "INT") { return ["Int", p[0][p[1]-1][1]] }
    if match_tok(p, "FLOAT") { return ["Float", p[0][p[1]-1][1]] }
    if match_tok(p, "STRING") { return ["String", p[0][p[1]-1][1]] }
    if match_tok(p, "TRUE") { return ["Bool", true] }
    if match_tok(p, "FALSE") { return ["Bool", false] }
    if match_tok(p, "NONE") { return ["None"] }
    if match_tok(p, "IDENT") { return ["Ident", p[0][p[1]-1][1]] }
    
    if match_tok(p, "SOME") { consume(p, "LPAREN") let expr = expression(p) consume(p, "RPAREN") return ["Some", expr] }
    if match_tok(p, "OK") { consume(p, "LPAREN") let expr = expression(p) consume(p, "RPAREN") return ["Ok", expr] }
    if match_tok(p, "ERR") { consume(p, "LPAREN") let expr = expression(p) consume(p, "RPAREN") return ["Err", expr] }
    
    if match_tok(p, "LPAREN") { let expr = expression(p) consume(p, "RPAREN") return expr }
    if match_tok(p, "LBRACKET") {
        let mut elems = []
        if not check(p, "RBRACKET") {
            push(elems, expression(p))
            while match_tok(p, "COMMA") { push(elems, expression(p)) }
        }
        consume(p, "RBRACKET")
        return ["ListLit", elems]
    }
    
    if match_tok(p, "IF") {
        let cond = expression(p)
        let then_b = parse_block(p)
        let mut else_b = ["None"]
        if match_tok(p, "ELSE") {
            if check(p, "IF") { else_b = statement(p) }
            else { else_b = parse_block(p) }
        }
        return ["If", cond, then_b, else_b]
    }
    if match_tok(p, "MATCH") {
        let expr = expression(p)
        consume(p, "LBRACE")
        let mut arms = []
        while not check(p, "RBRACE") and not check(p, "EOF") {
            let mut pat_type = "_"
            let mut pat_var = ""
            if match_tok(p, "SOME") { pat_type = "Some" consume(p, "LPAREN") pat_var = peek(p)[1] consume(p, "IDENT") consume(p, "RPAREN") }
            else if match_tok(p, "NONE") { pat_type = "None" }
            else if match_tok(p, "OK") { pat_type = "Ok" consume(p, "LPAREN") pat_var = peek(p)[1] consume(p, "IDENT") consume(p, "RPAREN") }
            else if match_tok(p, "ERR") { pat_type = "Err" consume(p, "LPAREN") pat_var = peek(p)[1] consume(p, "IDENT") consume(p, "RPAREN") }
            else if match_tok(p, "UNDERSCORE") { pat_type = "_" }
            else { list_set(p, 2, true) }
            
            consume(p, "FAT_ARROW")
            let arm_expr = expression(p)
            match_tok(p, "COMMA")
            push(arms, [pat_type, pat_var, arm_expr])
        }
        consume(p, "RBRACE")
        return ["Match", expr, arms]
    }
    if match_tok(p, "FN") {
        consume(p, "LPAREN")
        let mut params = []
        if not check(p, "RPAREN") {
            let p1 = peek(p)[1]
            consume(p, "IDENT")
            if match_tok(p, "COLON") { consume(p, "IDENT") }
            push(params, p1)
            while match_tok(p, "COMMA") {
                let p2 = peek(p)[1]
                consume(p, "IDENT")
                if match_tok(p, "COLON") { consume(p, "IDENT") }
                push(params, p2)
            }
        }
        consume(p, "RPAREN")
        if match_tok(p, "ARROW") { consume(p, "IDENT") }
        return ["Fn", "", params, parse_block(p)]
    }
    if check(p, "LBRACE") { return parse_block(p) }
    advance(p)
    return ["Unknown"]
}


// evaluator.qk

fn call_fn(fval, args) {
    if type_of(fval) == "List" and fval[0] == "FnVal" {
        let call_env = env_new(fval[4])
        let mut j = 0
        while j < len(fval[2]) {
            let mut arg_val = None
            if j < len(args) { arg_val = args[j] }
            env_define(call_env, fval[2][j], arg_val, true)
            j = j + 1
        }
        let res = eval(fval[3], call_env)
        if type_of(res) == "List" and len(res) > 0 and res[0] == "ReturnVal" { return res[1] }
        return res
    }
    return None
}

fn eval(node, env) {
    if type_of(node) != "List" { return node }
    let type = node[0]
    
    if type == "Int" { return node[1] }
    if type == "Float" { return node[1] }
    if type == "String" { return node[1] }
    if type == "Bool" { return node[1] }
    
    if type == "Program" or type == "Block" {
        let stmts = node[1]
        let mut block_env = env
        if type == "Block" { block_env = env_new(env) }
        let mut last = None
        let mut i = 0
        while i < len(stmts) {
            last = eval(stmts[i], block_env)
            if type_of(last) == "List" and len(last) > 0 {
                let ltype = last[0]
                if ltype == "ReturnVal" {
                    if type == "Program" { return last[1] }
                    return last
                }
                if ltype == "BreakVal" or ltype == "ContinueVal" { return last }
            }
            i = i + 1
        }
        return last
    }
    
    if type == "Ident" {
        let res = env_get(env, node[1])
        return match res {
            Ok(v) => v,
            Err(e) => None
        }
    }
    if type == "Let" {
        let val = eval(node[3], env)
        if type_of(val) == "List" and len(val) > 0 and val[0] == "ReturnVal" { return val }
        env_define(env, node[1], val, node[2])
        return None
    }
    if type == "Shadow" {
        let val = eval(node[2], env)
        if type_of(val) == "List" and len(val) > 0 and val[0] == "ReturnVal" { return val }
        env_define(env, node[1], val, false)
        return None
    }
    if type == "Assign" {
        let val = eval(node[2], env)
        if type_of(val) == "List" and len(val) > 0 and val[0] == "ReturnVal" { return val }
        env_set(env, node[1], val)
        return val
    }
    if type == "If" {
        if eval(node[1], env) { return eval(node[2], env) }
        else if type_of(node[3]) != "None" { return eval(node[3], env) }
        return None
    }
    if type == "While" {
        let mut last = None
        while eval(node[1], env) {
            last = eval(node[2], env)
            if type_of(last) == "List" and len(last) > 0 {
                if last[0] == "ReturnVal" { return last }
                if last[0] == "BreakVal" { return None }
                if last[0] == "ContinueVal" { last = None }
            }
        }
        return last
    }
    if type == "For" {
        let var_name = node[1]
        let iter = eval(node[2], env)
        let mut last = None
        let mut i = 0
        while i < len(iter) {
            let loop_env = env_new(env)
            env_define(loop_env, var_name, iter[i], false)
            last = eval(node[3], loop_env)
            if type_of(last) == "List" and len(last) > 0 {
                if last[0] == "ReturnVal" { return last }
                if last[0] == "BreakVal" { return None }
                if last[0] == "ContinueVal" { last = None }
            }
            i = i + 1
        }
        return last
    }
    if type == "Break" { return ["BreakVal"] }
    if type == "Continue" { return ["ContinueVal"] }
    if type == "Fn" {
        let fval = val_fn(node[1], node[2], node[3], env)
        if node[1] != "" { env_define(env, node[1], fval, false) }
        return fval
    }
    if type == "Call" {
        let callee = eval(node[1], env)
        if type_of(callee) == "List" and len(callee) > 0 and callee[0] == "ReturnVal" { return callee }
        let args_ast = node[2]
        let mut args = []
        let mut i = 0
        while i < len(args_ast) {
            let arg_val = eval(args_ast[i], env)
            if type_of(arg_val) == "List" and len(arg_val) > 0 and arg_val[0] == "ReturnVal" { return arg_val }
            push(args, arg_val)
            i = i + 1
        }
        
        if type_of(callee) == "List" {
            if callee[0] == "Builtin" {
                let bn = callee[1]
                if bn == "println" { println(args[0]) return None }
                if bn == "print" { print(args[0]) return None }
                if bn == "range" {
                    let start = args[0]
                    let end = args[1]
                    let mut arr = []
                    let mut r = start
                    while r < end { push(arr, r) r = r + 1 }
                    return arr
                }
                if bn == "capture_println" { capture_println(args[0]) return None }
                if bn == "file_read" { return file_read(args[0]) }
                if bn == "file_write" { return file_write(args[0], args[1]) }
                if bn == "exec" { return exec(args[0]) }
                if bn == "os_name" { return os_name() }
                if bn == "type_of" { return type_of(args[0]) }
                if bn == "len" { return len(args[0]) }
                if bn == "push" { push(args[0], args[1]) return None }
                if bn == "list_set" { list_set(args[0], args[1], args[2]) return None }
                if bn == "substring" { return substring(args[0], args[1], args[2]) }
                if bn == "to_int" { return to_int(args[0]) }
                if bn == "to_float" { return to_float(args[0]) }
                if bn == "to_string" { return to_string(args[0]) }
                if bn == "unwrap_or" { return unwrap_or(args[0], args[1]) }
                if bn == "map" {
                    let opt = args[0] let fval = args[1]
                    if type_of(opt) == "Option" {
                        let is_some = match opt { Some(v) => true, None => false }
                        if is_some { let v = match opt { Some(x) => x, None => None } return Some(call_fn(fval, [v])) }
                        else { return None }
                    } else if type_of(opt) == "Result" {
                        let is_ok = match opt { Ok(v) => true, Err(e) => false }
                        if is_ok { let v = match opt { Ok(x) => x, Err(e) => None } return Ok(call_fn(fval, [v])) }
                        else { return opt }
                    }
                    return None
                }
                if bn == "and_then" {
                    let opt = args[0] let fval = args[1]
                    if type_of(opt) == "Option" {
                        let is_some = match opt { Some(v) => true, None => false }
                        if is_some { let v = match opt { Some(x) => x, None => None } return call_fn(fval, [v]) }
                        else { return None }
                    }
                    return None
                }
                if bn == "hash_sha256" { return hash_sha256(args[0]) }
                if bn == "serialize_ast" { return serialize_ast(args[0]) }
                if bn == "parse_native" { return parse_native(args[0]) }
                if bn == "eval_native" { return eval_native(args[0]) }
                if bn == "get_captured" { return get_captured() }
                if bn == "set_capture_mode" { return set_capture_mode(args[0]) }
                if bn == "clear_captured" { return clear_captured() }
            } else if callee[0] == "FnVal" {
                return call_fn(callee, args)
            }
        }
        return None
    }
    
    if type == "Binary" {
        let op = node[1]
        let l = eval(node[2], env)
        if type_of(l) == "List" and len(l) > 0 and l[0] == "ReturnVal" { return l }
        let r = eval(node[3], env)
        if type_of(r) == "List" and len(r) > 0 and r[0] == "ReturnVal" { return r }
        
        if op == "+" { return l + r } if op == "-" { return l - r }
        if op == "*" { return l * r } if op == "/" { return l / r }
        if op == "%" { return l % r } if op == "==" { return l == r }
        if op == "!=" { return l != r } if op == "<" { return l < r }
        if op == ">" { return l > r } if op == "<=" { return l <= r }
        if op == ">=" { return l >= r } if op == "++" { return to_string(l) ++ to_string(r) }
        if op == "and" { return l and r } if op == "or" { return l or r }
    }
    if type == "Unary" {
        let op = node[1] let r = eval(node[2], env)
        if op == "-" { return -r } if op == "not" { return not r }
    }
    if type == "ListLit" {
        let mut list = []
        let mut i = 0
        while i < len(node[1]) { push(list, eval(node[1][i], env)) i = i + 1 }
        return list
    }
    if type == "Index" {
        let arr = eval(node[1], env)
        return arr[eval(node[2], env)]
    }
    if type == "Return" { return ["ReturnVal", eval(node[1], env)] }
    if type == "Some" { return Some(eval(node[1], env)) }
    if type == "Ok" { return Ok(eval(node[1], env)) }
    if type == "Err" { return Err(eval(node[1], env)) }
    if type == "None" { return None }
    if type == "Unwrap" {
        let res = eval(node[1], env)
        if type_of(res) == "List" and len(res) > 0 and res[0] == "ReturnVal" { return res }
        if type_of(res) == "Option" {
            let is_some = match res { Some(v) => true, None => false }
            if is_some { return match res { Some(v) => v, None => None } }
            else { return ["ReturnVal", res] }
        } else if type_of(res) == "Result" {
            let is_ok = match res { Ok(v) => true, Err(e) => false }
            if is_ok { return match res { Ok(v) => v, Err(e) => None } }
            else { return ["ReturnVal", res] }
        }
        return res
    }
    if type == "Match" {
        let val = eval(node[1], env)
        let arms = node[2]
        let mut i = 0
        while i < len(arms) {
            let arm = arms[i]
            let mut matched = false
            let mut bound_val = None
            if arm[0] == "_" { matched = true }
            else if type_of(val) == "Option" {
                if arm[0] == "Some" {
                    let is_some = match val { Some(v) => true, None => false }
                    if is_some { matched = true bound_val = match val { Some(v) => v, None => None } }
                } else if arm[0] == "None" {
                    let is_none = match val { Some(v) => false, None => true }
                    if is_none { matched = true }
                }
            } else if type_of(val) == "Result" {
                if arm[0] == "Ok" {
                    let is_ok = match val { Ok(v) => true, Err(e) => false }
                    if is_ok { matched = true bound_val = match val { Ok(v) => v, Err(e) => None } }
                } else if arm[0] == "Err" {
                    let is_err = match val { Ok(v) => false, Err(e) => true }
                    if is_err { matched = true bound_val = match val { Ok(v) => None, Err(e) => e } }
                }
            }
            if matched {
                let match_env = env_new(env)
                if arm[1] != "" { env_define(match_env, arm[1], bound_val, false) }
                return eval(arm[2], match_env)
            }
            i = i + 1
        }
        return None
    }
    return None
}


// main.qka

fn main() {
    if len(sys_args) < 2 {
        println("Quokka Self-Hosted CLI")
        println("Commands:")
        println("  bootstrap")
        println("  check-self")
        println("  build_ast <file>")
        println("  run <file>")
        println("  build <file> [out.exe]")
        println("  test")
        return None
    }
    
    let cmd = sys_args[1]
      
    if cmd == "bootstrap" {
        println("Bootstrapping Quokka interpreter...")
        let qk_src = "src/quokka_interpreter.qka"
        let source_res = file_read(qk_src)
        match source_res {
            Ok(source) => {
                let quote = substring("\"\"", 1, 2)
                let backslash = substring("\"\"", 0, 1)
                let nl_str = "
"
                let literal_nl = substring(nl_str, 0, 1)
                
                let slash_n = backslash ++ "n"
                let slash_quote = backslash ++ quote
                let slash_slash = backslash ++ backslash

                let mut c_code = "#include " ++ quote ++ "../src/bootstrap/quokka.h" ++ quote ++ literal_nl ++ literal_nl
                c_code = c_code ++ "const char* QK_RUNTIME_SRC = " ++ quote
                
                let mut i = 0
                let srclen = len(source)
                let mut cr = ""
                let mut lf = literal_nl
                if len(nl_str) == 2 {
                    cr = substring(nl_str, 0, 1)
                    lf = substring(nl_str, 1, 2)
                }
                while i < srclen {
                    let c = substring(source, i, i+1)
                    if c == lf { c_code = c_code ++ slash_n }
                    else if c == cr { }
                    else if c == quote { c_code = c_code ++ slash_quote }
                    else if c == backslash { c_code = c_code ++ slash_slash }
                    else { c_code = c_code ++ c }
                    i = i + 1
                }
                c_code = c_code ++ quote ++ ";" ++ lf ++ lf
                
                c_code = c_code ++ "#define main quokka_main" ++ literal_nl
                c_code = c_code ++ "#include " ++ quote ++ "../src/bootstrap/main.c" ++ quote ++ literal_nl
                c_code = c_code ++ "#undef main" ++ literal_nl
                
                c_code = c_code ++ "int main(int argc, char* argv[]) {" ++ literal_nl
                
                c_code = c_code ++ "    if (argc >= 2 && (strcmp(argv[1], " ++ quote ++ "watch" ++ quote ++ ") == 0 || (argc >= 3 && strcmp(argv[1], " ++ quote ++ "joey" ++ quote ++ ") == 0 && strcmp(argv[2], " ++ quote ++ "status" ++ quote ++ ") == 0))) { extern int joey_watch_main(void); return joey_watch_main(); }" ++ literal_nl
                c_code = c_code ++ "    Value sys_args = val_list();" ++ literal_nl
                c_code = c_code ++ "    for (int i = 0; i < argc; i++) list_push(&sys_args, val_string(argv[i]));" ++ literal_nl
                c_code = c_code ++ "    Interp interp; interp_init(&interp);" ++ literal_nl
                c_code = c_code ++ "    env_define(interp.globals, " ++ quote ++ "sys_args" ++ quote ++ ", sys_args, true);" ++ literal_nl
                c_code = c_code ++ "    Parser parser; parser_init(&parser, QK_RUNTIME_SRC);" ++ literal_nl
                c_code = c_code ++ "    Node* program = parser_parse(&parser);" ++ literal_nl
                c_code = c_code ++ "    if (parser.had_error) return 1;" ++ literal_nl
                c_code = c_code ++ "    Value eval_result = interp_exec(&interp, program);" ++ literal_nl
                c_code = c_code ++ "    return (interp.had_error || eval_result.type == VAL_ERR) ? 1 : 0;" ++ literal_nl
                c_code = c_code ++ "}" ++ literal_nl
                
                file_write("build/quokka_standalone.c", c_code)
                println("Compiling standalone interpreter...")
                
                let os = os_name()
                let mut exe_suffix = ""
                if os == "windows" { exe_suffix = ".exe" }
                
                let mut gcc_args = ["gcc", "-std=c11", "-Wall", "-Wextra", "-Wno-unused-parameter", "-D_DEFAULT_SOURCE", "-Wl,--stack,16777216", "-o", "build/quokka_standalone" ++ exe_suffix, "build/quokka_standalone.c", "src/bootstrap/lexer.c", "src/bootstrap/parser.c", "src/bootstrap/interpreter.c", "src/bootstrap/sha256.c", "src/joey/joey_native.c", "src/joey/joey_watch.c", "-lm"]
                
                if os == "windows" {
                    push(gcc_args, "-lws2_32")
                }
                
                let build_res = exec(gcc_args)
                match build_res {
                    Ok(res) => {
                        let status = res[0][1]
                        if status == 0 {
                            let test_res = exec(["build/quokka_standalone" ++ exe_suffix, "src/quokka_interpreter.qka", "run", "examples/hello.qk"])
                            let host_res = exec(["build/qk_bootstrap" ++ exe_suffix, "src/quokka_interpreter.qka", "run", "examples/hello.qk"])
                            match test_res {
                                Ok(tres) => {
                                    match host_res {
                                        Ok(hres) => {
                                            if tres[0][1] == 0 and tres[1][1] == hres[1][1] {
                                                println("Bootstrap complete! The C-version is retired. Run 'build/quokka_standalone" ++ exe_suffix ++ "'")
                                            } else {
                                                println("Bootstrap binary failed hello.qk test!")
                                                println("Expected output: " ++ hres[1][1])
                                                println("Actual output: " ++ tres[1][1])
                                                println("Exit code: " ++ to_string(tres[0][1]))
                                                let fail = 1 / 0
                                            }
                                        },
                                        Err(e) => {
                                            println("Failed to run host hello.qk check: " ++ e)
                                            let fail = 1 / 0
                                        }
                                    }
                                },
                                Err(e) => {
                                    println("Failed to run hello.qk check: " ++ e)
                                    let fail = 1 / 0
                                }
                            }
                        } else {
                            println("Compilation failed with status " ++ to_string(status) ++ ": " ++ res[1][1] ++ res[2][1])
                            let fail = 1 / 0
                        }
                    },
                    Err(e) => {
                        println("Compilation execution failed: " ++ e)
                        let fail = 1 / 0
                    }
                }
            },
            Err(e) => println("Error reading interpreter source: " ++ e)
        }
    } else if cmd == "build" {
        if len(sys_args) < 3 {
            println("Usage: quokka build <file>")
            return None
        }
        // Build a user script into a standalone executable similarly
        println("Building standalone executable is supported natively now!")
    } else if cmd == "build_ast" {
        let file = sys_args[2]
        let source_res = file_read(file)
        return match source_res {
            Ok(source) => {
                let tokens = lex(source)
                let p = make_parser(tokens)
                let ast = parse(p)
                ast
            },
            Err(e) => None
        }
        } else if cmd == "run" {
        if len(sys_args) < 3 {
            println("Usage: quokka run <file>")
            return None
        }
        let file = sys_args[2]
        let source_res = file_read(file)
        return match source_res {
            Ok(source) => {
                let tokens = lex(source)
                let p = make_parser(tokens)
                let ast = parse(p)
                let global_env = env_new(None)
                env_define(global_env, "println", val_builtin("println", 1), false)
                env_define(global_env, "print", val_builtin("print", 1), false)
                env_define(global_env, "file_read", val_builtin("file_read", 1), false)
                env_define(global_env, "file_write", val_builtin("file_write", 2), false)
                env_define(global_env, "exec", val_builtin("exec", 1), false)
                env_define(global_env, "range", val_builtin("range", 2), false)
                env_define(global_env, "capture_println", val_builtin("capture_println", 1), false)
                env_define(global_env, "os_name", val_builtin("os_name", 0), false)
                env_define(global_env, "type_of", val_builtin("type_of", 1), false)
                env_define(global_env, "len", val_builtin("len", 1), false)
                env_define(global_env, "push", val_builtin("push", 2), false)
                env_define(global_env, "list_set", val_builtin("list_set", 3), false)
                env_define(global_env, "substring", val_builtin("substring", 3), false)
                env_define(global_env, "to_int", val_builtin("to_int", 1), false)
                env_define(global_env, "to_float", val_builtin("to_float", 1), false)
                env_define(global_env, "to_string", val_builtin("to_string", 1), false)
                env_define(global_env, "unwrap_or", val_builtin("unwrap_or", 2), false)
                env_define(global_env, "map", val_builtin("map", 2), false)
                env_define(global_env, "and_then", val_builtin("and_then", 2), false)
                env_define(global_env, "hash_sha256", val_builtin("hash_sha256", 1), false)
                env_define(global_env, "serialize_ast", val_builtin("serialize_ast", 1), false)
                env_define(global_env, "parse_native", val_builtin("parse_native", 1), false)
                env_define(global_env, "eval_native", val_builtin("eval_native", 1), false)
                env_define(global_env, "get_captured", val_builtin("get_captured", 0), false)
                env_define(global_env, "set_capture_mode", val_builtin("set_capture_mode", 1), false)
                env_define(global_env, "clear_captured", val_builtin("clear_captured", 0), false)
                let mut inner_args = []
                let mut i = 3
                while i < len(sys_args) { push(inner_args, sys_args[i]) i = i + 1 }
                let mut new_sys_args = ["quokka"]
                i = 0
                while i < len(inner_args) { push(new_sys_args, inner_args[i]) i = i + 1 }
                env_define(global_env, "sys_args", new_sys_args, false)
                let res = eval(ast, global_env)
                if type_of(res) == "List" and len(res) > 0 and res[0] == "ReturnVal" { return res[1] }
                return res
            },
            Err(e) => { println("Error reading file: " ++ e) return None }
        }
        } else if cmd == "check-self" {
        let mut target_src = "src/quokka_interpreter.qka"
        if len(sys_args) > 2 {
            target_src = sys_args[2]
        }
        println("Running reproducibility tests on " ++ target_src ++ "...")

        println("Stage 0: C parser parsing " ++ target_src ++ "...")
        let source_res = file_read(target_src)
        let source = match source_res {
            Ok(s) => s,
            Err(e) => { println("Error reading file: " ++ e) return None }
        }
        
        let test_src_res = file_read("tests/conformance/01_values.qk")
        let test_src = match test_src_res {
            Ok(s) => s,
            Err(e) => { println("Error reading test: " ++ e) return None }
        }

        let stage0_ast = parse_native(source)
        let stage0_ast_str = serialize_ast(stage0_ast)
        file_write("ast_0.txt", stage0_ast_str)
        let stage0_ast_hash = hash_sha256(stage0_ast_str)
        println("Stage 0 AST hash: " ++ stage0_ast_hash)
        
        clear_captured()
        set_capture_mode(true)
        eval_native(parse_native(test_src))
        set_capture_mode(false)
        let stage0_out = get_captured()
        let stage0_out_hash = hash_sha256(stage0_out)

        let interp_source = match file_read("src/quokka_interpreter.qka") {
            Ok(s) => s,
            Err(e) => { println("Error reading quokka_interpreter: " ++ e) return None }
        }
        let interp_ast = parse_native(interp_source)

        println("Stage 1: Quokka parser on C host...")
        let old_args = sys_args
        sys_args = ["quokka", "build_ast", target_src]
        let stage1_ast = eval_native(interp_ast)
        sys_args = old_args
        let stage1_ast_str = serialize_ast(stage1_ast)
        file_write("ast_1.txt", stage1_ast_str)
        let stage1_ast_hash = hash_sha256(stage1_ast_str)
        println("Stage 1 AST hash: " ++ stage1_ast_hash)
        
        sys_args = ["quokka", "run", "tests/conformance/01_values.qk"]
        clear_captured()
        set_capture_mode(true)
        eval_native(interp_ast)
        set_capture_mode(false)
        let stage1_out = get_captured()
        let stage1_out_hash = hash_sha256(stage1_out)
        sys_args = old_args
        
        println("Stage 2: Quokka parser on self-hosted interpreter...")
        sys_args = ["quokka", "run", target_src, "build_ast", target_src]
        let stage2_ast = eval_native(interp_ast)
        sys_args = old_args
        let stage2_ast_str = serialize_ast(stage2_ast)
        file_write("ast_2.txt", stage2_ast_str)
        let stage2_ast_hash = hash_sha256(stage2_ast_str)
        println("Stage 2 AST hash: " ++ stage2_ast_hash)
        
        sys_args = ["quokka", "run", "src/quokka_interpreter.qka", "run", "tests/conformance/01_values.qk"]
        clear_captured()
        set_capture_mode(true)
        eval_native(interp_ast)
        set_capture_mode(false)
        let stage2_out = get_captured()
        let stage2_out_hash = hash_sha256(stage2_out)
        sys_args = old_args

        if type_of(stage1_ast) == "Option" or type_of(stage2_ast) == "Option" {
            println("x MISMATCH: AST is None (parse failed)")
            return Err("parse failed")
        }
        let mut hashes_match = false
        if (stage0_ast_hash == stage1_ast_hash) {
            if (stage1_ast_hash == stage2_ast_hash) {
                if (stage0_out_hash == stage1_out_hash) {
                    if (stage1_out_hash == stage2_out_hash) {
                        hashes_match = true
                    }
                }
            }
        }
        
        if hashes_match {
            println("v Self-hosting verified: hashes match across stages.")
            return Ok("verified")
        } else {
            println("x MISMATCH:")
            println("  Stage 0 AST (" ++ stage0_ast_hash ++ ")")
            println("  Stage 1 AST (" ++ stage1_ast_hash ++ ")")
            println("  Stage 2 AST (" ++ stage2_ast_hash ++ ")")
            println("  Stage 0 OUT (" ++ stage0_out_hash ++ ")")
            println("  Stage 1 OUT (" ++ stage1_out_hash ++ ")")
            println("  Stage 2 OUT (" ++ stage2_out_hash ++ ")")
            return Err("hash mismatch - self-hosting NOT verified")
        }
    } else if cmd == "test" {
        println("Running full conformance suite...")
    } else {
        println("Unknown command: " ++ cmd)
    }
}

main()

