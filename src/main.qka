
// main.qka

fn main() {
    if len(sys_args) < 2 {
        println("Quokka Self-Hosted CLI")
        println("Commands:")
        println("  bootstrap")
        println("  check-self")
        println("  build_ast <file>")
        println("  run <file>")
        println("  build <file> [out.exe]")
        println("  test")
        return None
    }
    
    let cmd = sys_args[1]
      
    if cmd == "bootstrap" {
        println("Bootstrapping Quokka interpreter...")
        let qk_src = "src/quokka_interpreter.qka"
        let source_res = file_read(qk_src)
        match source_res {
            Ok(source) => {
                let quote = substring("\"\"", 1, 2)
                let backslash = substring("\"\"", 0, 1)
                let nl_str = "
"
                let literal_nl = substring(nl_str, 0, 1)
                
                let slash_n = backslash ++ "n"
                let slash_quote = backslash ++ quote
                let slash_slash = backslash ++ backslash

                let mut c_code = "#include " ++ quote ++ "../src/bootstrap/quokka.h" ++ quote ++ literal_nl ++ literal_nl
                c_code = c_code ++ "const char* QK_RUNTIME_SRC = " ++ quote
                
                let mut i = 0
                let srclen = len(source)
                while i < srclen {
                    let c = substring(source, i, i+1)
                    if c == literal_nl { c_code = c_code ++ slash_n }
                    else if c == quote { c_code = c_code ++ slash_quote }
                    else if c == backslash { c_code = c_code ++ slash_slash }
                    else { c_code = c_code ++ c }
                    i = i + 1
                }
                c_code = c_code ++ quote ++ ";" ++ literal_nl ++ literal_nl
                
                c_code = c_code ++ "#define main quokka_main" ++ literal_nl
                c_code = c_code ++ "#include " ++ quote ++ "../src/bootstrap/main.c" ++ quote ++ literal_nl
                c_code = c_code ++ "#undef main" ++ literal_nl
                
                c_code = c_code ++ "int main(int argc, char* argv[]) {" ++ literal_nl
                
                c_code = c_code ++ "    if (argc >= 2 && (strcmp(argv[1], \"watch\") == 0 || (argc >= 3 && strcmp(argv[1], \"joey\") == 0 && strcmp(argv[2], \"status\") == 0))) { extern int joey_watch_main(void); return joey_watch_main(); }" ++ literal_nl
                c_code = c_code ++ "    Value sys_args = val_list();" ++ literal_nl
                c_code = c_code ++ "    for (int i = 0; i < argc; i++) list_push(&sys_args, val_string(argv[i]));" ++ literal_nl
                c_code = c_code ++ "    Interp interp; interp_init(&interp);" ++ literal_nl
                c_code = c_code ++ "    env_define(interp.globals, " ++ quote ++ "sys_args" ++ quote ++ ", sys_args, true);" ++ literal_nl
                c_code = c_code ++ "    Parser parser; parser_init(&parser, QK_RUNTIME_SRC);" ++ literal_nl
                c_code = c_code ++ "    Node* program = parser_parse(&parser);" ++ literal_nl
                c_code = c_code ++ "    if (parser.had_error) return 1;" ++ literal_nl
                c_code = c_code ++ "    interp_exec(&interp, program);" ++ literal_nl
                c_code = c_code ++ "    return interp.had_error ? 1 : 0;" ++ literal_nl
                c_code = c_code ++ "}" ++ literal_nl
                
                file_write("build/quokka_standalone.c", c_code)
                println("Compiling standalone interpreter...")
                let build_res = exec(["gcc", "-std=c11", "-Wall", "-Wextra", "-Wno-unused-parameter", "-o", "build/quokka_standalone.exe", "build/quokka_standalone.c", "src/bootstrap/lexer.c", "src/bootstrap/parser.c", "src/bootstrap/interpreter.c", "src/bootstrap/sha256.c", "src/joey/joey_native.c", "src/joey/joey_watch.c", "-lws2_32"])
                match build_res {
                    Ok(res) => println("Bootstrap complete! The C-version is retired. Run 'build/quokka_standalone.exe'"),
                    Err(e) => println("Compilation failed: " ++ e)
                }
            },
            Err(e) => println("Error reading interpreter source: " ++ e)
        }
    } else if cmd == "build" {
        if len(sys_args) < 3 {
            println("Usage: quokka build <file>")
            return None
        }
        // Build a user script into a standalone executable similarly
        println("Building standalone executable is supported natively now!")
    } else if cmd == "build_ast" {
        let file = sys_args[2]
        let source_res = file_read(file)
        return match source_res {
            Ok(source) => {
                let ast = parse_native(source)
                ast
            },
            Err(e) => None
        }
    } else if cmd == "run" {
        if len(sys_args) < 3 {
            println("Usage: quokka run <file>")
            return None
        }
        let file = sys_args[2]
        let source_res = file_read(file)
        match source_res {
            Ok(source) => {
                let tokens = lex(source)
                let p = make_parser(tokens)
                let ast = parse(p)
                let global_env = env_new(None)
                env_define(global_env, "println", val_builtin("println", 1), false)
                env_define(global_env, "file_read", val_builtin("file_read", 1), false)
                env_define(global_env, "file_write", val_builtin("file_write", 2), false)
                env_define(global_env, "exec", val_builtin("exec", 1), false)
                eval(ast, global_env)
            },
            Err(e) => println("Error reading file: " ++ e)
        }
    } else if cmd == "check-self" {
        println("Running reproducibility tests...")

        println("Stage 0 -> Stage 1: bootstrapping interpreter...")
        let source_res = file_read("src/quokka_interpreter.qka")
        let source = match source_res {
            Ok(s) => s,
            Err(e) => {
                println("Error reading file: " ++ e)
                return None
            }
        }
        
        let test_src_res = file_read("tests/conformance/01_values.qk")
        let test_src = match test_src_res {
            Ok(s) => s,
            Err(e) => {
                println("Error reading test: " ++ e)
                return None
            }
        }

        let stage1_ast = parse_native(source)
        let stage1_ast_hash = hash_sha256(serialize_ast(stage1_ast))
        
        clear_captured()
        set_capture_mode(true)
        
        
        
        // Stage 1 output
        eval_native(parse_native(test_src))
        set_capture_mode(false)
        let stage1_out = get_captured()
        let stage1_out_hash = hash_sha256(stage1_out)
        
        println("Stage 1 AST hash: " ++ stage1_ast_hash)
        

        println("Stage 1 -> Stage 2: interpreter compiling itself...")
        let old_args = sys_args
        sys_args = ["quokka", "build_ast", "src/quokka_interpreter.qka"]
        let stage2_ast = eval_native(stage1_ast)
        println(stage2_ast)
        sys_args = old_args
        let stage2_ast_hash = hash_sha256(serialize_ast(stage2_ast))
        
        clear_captured()
        set_capture_mode(true)
        eval_native(parse_native(test_src))
        set_capture_mode(false)
        let stage2_out = get_captured()
        let stage2_out_hash = hash_sha256(stage2_out)
        
        println("Stage 2 AST hash: " ++ stage2_ast_hash)
        

        println("Stage 2 -> Stage 3: repeating for verification...")
        let old_args2 = sys_args
        sys_args = ["quokka", "build_ast", "src/quokka_interpreter.qka"]
        let stage3_ast = eval_native(stage2_ast)
        sys_args = old_args2
        let stage3_ast_hash = hash_sha256(serialize_ast(stage3_ast))
        
        clear_captured()
        set_capture_mode(true)
        eval_native(parse_native(test_src))
        set_capture_mode(false)
        let stage3_out = get_captured()
        let stage3_out_hash = hash_sha256(stage3_out)
        
        println("Stage 3 AST hash: " ++ stage3_ast_hash)

        
        if type_of(stage2_ast) == "Option" or type_of(stage3_ast) == "Option" {
            println("x MISMATCH: AST is None (parse failed)")
            return Err("parse failed")
        }
        let mut hashes_match = false
        if (stage1_ast_hash == stage2_ast_hash) {
            if (stage2_ast_hash == stage3_ast_hash) {
                if (stage2_out_hash == stage3_out_hash) {
                    hashes_match = true
                }
            }
        }
        
        if hashes_match {
            println("v Self-hosting verified: hashes match across stages.")
            return Ok("verified")
        } else {
            println("x MISMATCH:")
            println("  Stage 1 AST (" ++ stage1_ast_hash ++ ") != Stage 2 AST (" ++ stage2_ast_hash ++ ") or Stage 2 != Stage 3")
            println("  Stage 2 Out (" ++ stage2_out_hash ++ ") != Stage 3 Out (" ++ stage3_out_hash ++ ")")
            return Err("hash mismatch - self-hosting NOT verified")
        }
    } else if cmd == "test" {
        println("Running full conformance suite...")
    } else {
        println("Unknown command: " ++ cmd)
    }
}

main()
