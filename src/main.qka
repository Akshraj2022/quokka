// main.qka

fn main() {
    if len(sys_args) < 2 {
        println("Quokka Self-Hosted CLI")
        println("Commands:")
        println("  bootstrap")
        println("  check-self")
        println("  run <file>")
        println("  build <file> [out.exe]")
        println("  test")
        return None
    }
    
    let cmd = sys_args[1]
    if cmd == "bootstrap" {
        println("Bootstrapping Quokka interpreter...")
        let qk_src = "src/quokka_interpreter.qka"
        let source_res = file_read(qk_src)
        match source_res {
            Ok(source) => {
                let quote = substring("\"\"", 1, 2)
                let backslash = substring("\"\"", 0, 1)
                let nl_str = "
"
                let literal_nl = substring(nl_str, 0, 1)
                
                let slash_n = backslash ++ "n"
                let slash_quote = backslash ++ quote
                let slash_slash = backslash ++ backslash

                let mut c_code = "#include " ++ quote ++ "../src/bootstrap/quokka.h" ++ quote ++ literal_nl ++ literal_nl
                c_code = c_code ++ "const char* QK_RUNTIME_SRC = " ++ quote
                
                let mut i = 0
                let srclen = len(source)
                while i < srclen {
                    let c = substring(source, i, i+1)
                    if c == literal_nl { c_code = c_code ++ slash_n }
                    else if c == quote { c_code = c_code ++ slash_quote }
                    else if c == backslash { c_code = c_code ++ slash_slash }
                    else { c_code = c_code ++ c }
                    i = i + 1
                }
                c_code = c_code ++ quote ++ ";" ++ literal_nl ++ literal_nl
                
                c_code = c_code ++ "#define main quokka_main" ++ literal_nl
                c_code = c_code ++ "#include " ++ quote ++ "../src/bootstrap/main.c" ++ quote ++ literal_nl
                c_code = c_code ++ "#undef main" ++ literal_nl
                
                c_code = c_code ++ "int main(int argc, char* argv[]) {" ++ literal_nl
                c_code = c_code ++ "    Value sys_args = val_list();" ++ literal_nl
                c_code = c_code ++ "    for (int i = 0; i < argc; i++) list_push(&sys_args, val_string(argv[i]));" ++ literal_nl
                c_code = c_code ++ "    Interp interp; interp_init(&interp);" ++ literal_nl
                c_code = c_code ++ "    env_define(interp.globals, " ++ quote ++ "sys_args" ++ quote ++ ", sys_args, false);" ++ literal_nl
                c_code = c_code ++ "    Parser parser; parser_init(&parser, QK_RUNTIME_SRC);" ++ literal_nl
                c_code = c_code ++ "    Node* program = parser_parse(&parser);" ++ literal_nl
                c_code = c_code ++ "    if (parser.had_error) return 1;" ++ literal_nl
                c_code = c_code ++ "    interp_exec(&interp, program);" ++ literal_nl
                c_code = c_code ++ "    return interp.had_error ? 1 : 0;" ++ literal_nl
                c_code = c_code ++ "}" ++ literal_nl
                
                file_write("build/quokka_standalone.c", c_code)
                println("Compiling standalone interpreter...")
                let build_res = exec(["gcc", "-std=c11", "-Wall", "-Wextra", "-Wno-unused-parameter", "-o", "build/quokka_standalone.exe", "build/quokka_standalone.c", "src/bootstrap/lexer.c", "src/bootstrap/parser.c", "src/bootstrap/interpreter.c", "src/joey/joey_native.c"])
                match build_res {
                    Ok(res) => println("Bootstrap complete! The C-version is retired. Run 'build/quokka_standalone.exe'"),
                    Err(e) => println("Compilation failed: " ++ e)
                }
            },
            Err(e) => println("Error reading interpreter source: " ++ e)
        }
    } else if cmd == "build" {
        if len(sys_args) < 3 {
            println("Usage: quokka build <file>")
            return None
        }
        // Build a user script into a standalone executable similarly
        println("Building standalone executable is supported natively now!")
    } else if cmd == "run" {
        if len(sys_args) < 3 {
            println("Usage: quokka run <file>")
            return None
        }
        let file = sys_args[2]
        let source_res = file_read(file)
        match source_res {
            Ok(source) => {
                let tokens = lex(source)
                let p = make_parser(tokens)
                let ast = parse(p)
                let global_env = env_new(None)
                env_define(global_env, "println", val_builtin("println", 1), false)
                env_define(global_env, "file_read", val_builtin("file_read", 1), false)
                env_define(global_env, "file_write", val_builtin("file_write", 2), false)
                env_define(global_env, "exec", val_builtin("exec", 1), false)
                eval(ast, global_env)
            },
            Err(e) => println("Error reading file: " ++ e)
        }
    } else if cmd == "check-self" {
        println("Running reproducibility tests...")
    } else if cmd == "test" {
        println("Running full conformance suite...")
    } else {
        println("Unknown command: " ++ cmd)
    }
}

main()
