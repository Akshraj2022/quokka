
// main.qka

fn main() {
    if len(sys_args) < 2 {
        println("Quokka Self-Hosted CLI")
        println("Commands:")
        println("  bootstrap")
        println("  check-self")
        println("  build_ast <file>")
        println("  run <file>")
        println("  build <file> [out.exe]")
        println("  test")
        return None
    }
    
    let cmd = sys_args[1]
      
    if cmd == "bootstrap" {
        println("Bootstrapping Quokka interpreter...")
        let qk_src = "src/quokka_interpreter.qka"
        let source_res = file_read(qk_src)
        match source_res {
            Ok(source) => {
                let quote = substring("\"\"", 1, 2)
                let backslash = substring("\"\"", 0, 1)
                let nl_str = "
"
                let literal_nl = substring(nl_str, 0, 1)
                
                let slash_n = backslash ++ "n"
                let slash_quote = backslash ++ quote
                let slash_slash = backslash ++ backslash

                let mut c_code = "#include " ++ quote ++ "../src/bootstrap/quokka.h" ++ quote ++ literal_nl ++ literal_nl
                c_code = c_code ++ "const char* QK_RUNTIME_SRC = " ++ quote
                
                let mut i = 0
                let srclen = len(source)
                let mut cr = ""
                let mut lf = literal_nl
                if len(nl_str) == 2 {
                    cr = substring(nl_str, 0, 1)
                    lf = substring(nl_str, 1, 2)
                }
                while i < srclen {
                    let c = substring(source, i, i+1)
                    if c == lf { c_code = c_code ++ slash_n }
                    else if c == cr { }
                    else if c == quote { c_code = c_code ++ slash_quote }
                    else if c == backslash { c_code = c_code ++ slash_slash }
                    else { c_code = c_code ++ c }
                    i = i + 1
                }
                c_code = c_code ++ quote ++ ";" ++ lf ++ lf
                
                c_code = c_code ++ "#define main quokka_main" ++ literal_nl
                c_code = c_code ++ "#include " ++ quote ++ "../src/bootstrap/main.c" ++ quote ++ literal_nl
                c_code = c_code ++ "#undef main" ++ literal_nl
                
                c_code = c_code ++ "int main(int argc, char* argv[]) {" ++ literal_nl
                
                c_code = c_code ++ "    if (argc >= 2 && (strcmp(argv[1], " ++ quote ++ "watch" ++ quote ++ ") == 0 || (argc >= 3 && strcmp(argv[1], " ++ quote ++ "joey" ++ quote ++ ") == 0 && strcmp(argv[2], " ++ quote ++ "status" ++ quote ++ ") == 0))) { extern int joey_watch_main(void); return joey_watch_main(); }" ++ literal_nl
                c_code = c_code ++ "    Value sys_args = val_list();" ++ literal_nl
                c_code = c_code ++ "    for (int i = 0; i < argc; i++) list_push(&sys_args, val_string(argv[i]));" ++ literal_nl
                c_code = c_code ++ "    Interp interp; interp_init(&interp);" ++ literal_nl
                c_code = c_code ++ "    env_define(interp.globals, " ++ quote ++ "sys_args" ++ quote ++ ", sys_args, true);" ++ literal_nl
                c_code = c_code ++ "    Parser parser; parser_init(&parser, QK_RUNTIME_SRC);" ++ literal_nl
                c_code = c_code ++ "    Node* program = parser_parse(&parser);" ++ literal_nl
                c_code = c_code ++ "    if (parser.had_error) return 1;" ++ literal_nl
                c_code = c_code ++ "    Value eval_result = interp_exec(&interp, program);" ++ literal_nl
                c_code = c_code ++ "    return (interp.had_error || eval_result.type == VAL_ERR) ? 1 : 0;" ++ literal_nl
                c_code = c_code ++ "}" ++ literal_nl
                
                file_write("build/quokka_standalone.c", c_code)
                println("Compiling standalone interpreter...")
                
                let os = os_name()
                let mut exe_suffix = ""
                if os == "windows" { exe_suffix = ".exe" }
                
                let mut gcc_args = ["gcc", "-std=c11", "-Wall", "-Wextra", "-Wno-unused-parameter", "-D_DEFAULT_SOURCE", "-Wl,--stack,16777216", "-o", "build/quokka_standalone" ++ exe_suffix, "build/quokka_standalone.c", "src/bootstrap/lexer.c", "src/bootstrap/parser.c", "src/bootstrap/interpreter.c", "src/bootstrap/sha256.c", "src/joey/joey_native.c", "src/joey/joey_watch.c", "-lm"]
                
                if os == "windows" {
                    push(gcc_args, "-lws2_32")
                }
                
                let build_res = exec(gcc_args)
                match build_res {
                    Ok(res) => {
                        let status = res[0][1]
                        if status == 0 {
                            let test_res = exec(["build/quokka_standalone" ++ exe_suffix, "run", "examples/hello.qk"])
                            let host_res = exec(["build/qk_bootstrap" ++ exe_suffix, "src/quokka_interpreter.qka", "run", "examples/hello.qk"])
                            match test_res {
                                Ok(tres) => {
                                    match host_res {
                                        Ok(hres) => {
                                            if tres[0][1] == 0 and tres[1][1] == hres[1][1] {
                                                println("Bootstrap complete! The C-version is retired. Run 'build/quokka_standalone" ++ exe_suffix ++ "'")
                                            } else {
                                                println("Bootstrap binary failed hello.qk test!")
                                                println("Expected output: " ++ hres[1][1])
                                                println("Actual output: " ++ tres[1][1])
                                                println("Exit code: " ++ to_string(tres[0][1]))
                                                let fail = 1 / 0
                                            }
                                        },
                                        Err(e) => {
                                            println("Failed to run host hello.qk check: " ++ e)
                                            let fail = 1 / 0
                                        }
                                    }
                                },
                                Err(e) => {
                                    println("Failed to run hello.qk check: " ++ e)
                                    let fail = 1 / 0
                                }
                            }
                        } else {
                            println("Compilation failed with status " ++ to_string(status) ++ ": " ++ res[1][1] ++ res[2][1])
                            let fail = 1 / 0
                        }
                    },
                    Err(e) => {
                        println("Compilation execution failed: " ++ e)
                        let fail = 1 / 0
                    }
                }
            },
            Err(e) => println("Error reading interpreter source: " ++ e)
        }
    } else if cmd == "build" {
        if len(sys_args) < 3 {
            println("Usage: quokka build <file>")
            return None
        }
        // Build a user script into a standalone executable similarly
        println("Building standalone executable is supported natively now!")
    } else if cmd == "build_ast" {
        let file = sys_args[2]
        let source_res = file_read(file)
        return match source_res {
            Ok(source) => {
                let tokens = lex(source)
                let p = make_parser(tokens)
                let ast = parse(p)
                ast
            },
            Err(e) => None
        }
        } else if cmd == "run" {
        if len(sys_args) < 3 {
            println("Usage: quokka run <file>")
            return None
        }
        let file = sys_args[2]
        let source_res = file_read(file)
        return match source_res {
            Ok(source) => {
                let tokens = lex(source)
                let p = make_parser(tokens)
                let ast = parse(p)
                let global_env = env_new(None)
                env_define(global_env, "println", val_builtin("println", 1), false)
                env_define(global_env, "print", val_builtin("print", 1), false)
                env_define(global_env, "file_read", val_builtin("file_read", 1), false)
                env_define(global_env, "file_write", val_builtin("file_write", 2), false)
                env_define(global_env, "exec", val_builtin("exec", 1), false)
                env_define(global_env, "range", val_builtin("range", 2), false)
                env_define(global_env, "capture_println", val_builtin("capture_println", 1), false)
                env_define(global_env, "os_name", val_builtin("os_name", 0), false)
                env_define(global_env, "type_of", val_builtin("type_of", 1), false)
                env_define(global_env, "len", val_builtin("len", 1), false)
                env_define(global_env, "push", val_builtin("push", 2), false)
                env_define(global_env, "list_set", val_builtin("list_set", 3), false)
                env_define(global_env, "substring", val_builtin("substring", 3), false)
                env_define(global_env, "to_int", val_builtin("to_int", 1), false)
                env_define(global_env, "to_float", val_builtin("to_float", 1), false)
                env_define(global_env, "to_string", val_builtin("to_string", 1), false)
                env_define(global_env, "unwrap_or", val_builtin("unwrap_or", 2), false)
                env_define(global_env, "map", val_builtin("map", 2), false)
                env_define(global_env, "and_then", val_builtin("and_then", 2), false)
                env_define(global_env, "hash_sha256", val_builtin("hash_sha256", 1), false)
                env_define(global_env, "serialize_ast", val_builtin("serialize_ast", 1), false)
                env_define(global_env, "parse_native", val_builtin("parse_native", 1), false)
                env_define(global_env, "eval_native", val_builtin("eval_native", 1), false)
                env_define(global_env, "get_captured", val_builtin("get_captured", 0), false)
                env_define(global_env, "set_capture_mode", val_builtin("set_capture_mode", 1), false)
                env_define(global_env, "clear_captured", val_builtin("clear_captured", 0), false)
                let mut inner_args = []
                let mut i = 3
                while i < len(sys_args) { push(inner_args, sys_args[i]) i = i + 1 }
                let mut new_sys_args = ["quokka"]
                i = 0
                while i < len(inner_args) { push(new_sys_args, inner_args[i]) i = i + 1 }
                env_define(global_env, "sys_args", new_sys_args, false)
                let res = eval(ast, global_env)
                if type_of(res) == "List" and len(res) > 0 and res[0] == "ReturnVal" { return res[1] }
                return res
            },
            Err(e) => { println("Error reading file: " ++ e) return None }
        }
        } else if cmd == "check-self" {
        let mut target_src = "src/quokka_interpreter.qka"
        if len(sys_args) > 2 {
            target_src = sys_args[2]
        }
        println("Running reproducibility tests on " ++ target_src ++ "...")

        println("Stage 0: C parser parsing " ++ target_src ++ "...")
        let source_res = file_read(target_src)
        let source = match source_res {
            Ok(s) => s,
            Err(e) => { println("Error reading file: " ++ e) return None }
        }
        
        let test_src_res = file_read("tests/conformance/01_values.qk")
        let test_src = match test_src_res {
            Ok(s) => s,
            Err(e) => { println("Error reading test: " ++ e) return None }
        }

        let stage0_ast = parse_native(source)
        let stage0_ast_str = serialize_ast(stage0_ast)
        file_write("ast_0.txt", stage0_ast_str)
        let stage0_ast_hash = hash_sha256(stage0_ast_str)
        println("Stage 0 AST hash: " ++ stage0_ast_hash)
        
        clear_captured()
        set_capture_mode(true)
        eval_native(parse_native(test_src))
        set_capture_mode(false)
        let stage0_out = get_captured()
        let stage0_out_hash = hash_sha256(stage0_out)

        let interp_source = match file_read("src/quokka_interpreter.qka") {
            Ok(s) => s,
            Err(e) => { println("Error reading quokka_interpreter: " ++ e) return None }
        }
        let interp_ast = parse_native(interp_source)

        println("Stage 1: Quokka parser on C host...")
        let old_args = sys_args
        sys_args = ["quokka", "build_ast", target_src]
        let stage1_ast = eval_native(interp_ast)
        sys_args = old_args
        let stage1_ast_str = serialize_ast(stage1_ast)
        file_write("ast_1.txt", stage1_ast_str)
        let stage1_ast_hash = hash_sha256(stage1_ast_str)
        println("Stage 1 AST hash: " ++ stage1_ast_hash)
        
        sys_args = ["quokka", "run", "tests/conformance/01_values.qk"]
        clear_captured()
        set_capture_mode(true)
        eval_native(interp_ast)
        set_capture_mode(false)
        let stage1_out = get_captured()
        let stage1_out_hash = hash_sha256(stage1_out)
        sys_args = old_args
        
        println("Stage 2: Quokka parser on self-hosted interpreter...")
        sys_args = ["quokka", "run", target_src, "build_ast", target_src]
        let stage2_ast = eval_native(interp_ast)
        sys_args = old_args
        let stage2_ast_str = serialize_ast(stage2_ast)
        file_write("ast_2.txt", stage2_ast_str)
        let stage2_ast_hash = hash_sha256(stage2_ast_str)
        println("Stage 2 AST hash: " ++ stage2_ast_hash)
        
        sys_args = ["quokka", "run", "src/quokka_interpreter.qka", "run", "tests/conformance/01_values.qk"]
        clear_captured()
        set_capture_mode(true)
        eval_native(interp_ast)
        set_capture_mode(false)
        let stage2_out = get_captured()
        let stage2_out_hash = hash_sha256(stage2_out)
        sys_args = old_args

        if type_of(stage1_ast) == "Option" or type_of(stage2_ast) == "Option" {
            println("x MISMATCH: AST is None (parse failed)")
            return Err("parse failed")
        }
        let mut hashes_match = false
        if (stage0_ast_hash == stage1_ast_hash) {
            if (stage1_ast_hash == stage2_ast_hash) {
                if (stage0_out_hash == stage1_out_hash) {
                    if (stage1_out_hash == stage2_out_hash) {
                        hashes_match = true
                    }
                }
            }
        }
        
        if hashes_match {
            println("v Self-hosting verified: hashes match across stages.")
            return Ok("verified")
        } else {
            println("x MISMATCH:")
            println("  Stage 0 AST (" ++ stage0_ast_hash ++ ")")
            println("  Stage 1 AST (" ++ stage1_ast_hash ++ ")")
            println("  Stage 2 AST (" ++ stage2_ast_hash ++ ")")
            println("  Stage 0 OUT (" ++ stage0_out_hash ++ ")")
            println("  Stage 1 OUT (" ++ stage1_out_hash ++ ")")
            println("  Stage 2 OUT (" ++ stage2_out_hash ++ ")")
            return Err("hash mismatch - self-hosting NOT verified")
        }
    } else if cmd == "test" {
        println("Running full conformance suite...")
    } else {
        println("Unknown command: " ++ cmd)
    }
}

main()
