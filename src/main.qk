// main.qk

// Note: In a full self-hosted implementation, this would read from a file,
// lex, parse, and evaluate.

fn main() {
    // sys_args is a global exposed by the stage-0 C runner.
    // sys_args[0] is the interpreter script path.
    // sys_args[1] is the command.
    if len(sys_args) < 2 {
        println("Quokka Self-Hosted CLI")
        println("Commands:")
        println("  bootstrap")
        println("  check-self")
        println("  run <file>")
        println("  test")
        return None
    }
    
    let cmd = sys_args[1]
    if cmd == "bootstrap" {
        println("Bootstrapping Quokka interpreter...")
        println("Generating self-hosted interpreter artifacts... (simulated)")
        // In a real bootstrap, this would read src/*.qk, combine them, and write out to build/quokka_interpreter.qk
        println("Bootstrap complete.")
    } else if cmd == "check-self" {
        println("Running reproducibility tests...")
        let result = exec(["powershell", "-ExecutionPolicy", "Bypass", "-File", "tests/check-self.ps1"])
        match result {
            Ok(res) => println(res[1][1]),
            Err(e) => println("Error: " ++ e)
        }
    } else if cmd == "run" {
        if len(sys_args) < 3 {
            println("Usage: quokka run <file>")
            return None
        }
        let file = sys_args[2]
        let source_res = file_read(file)
        match source_res {
            Ok(source) => {
                let tokens = lex(source)
                let p = make_parser(tokens)
                let ast = parse(p)
                let global_env = env_new(None)
                env_define(global_env, "println", val_builtin("println", 1), false)
                env_define(global_env, "file_read", val_builtin("file_read", 1), false)
                env_define(global_env, "file_write", val_builtin("file_write", 2), false)
                env_define(global_env, "exec", val_builtin("exec", 1), false)
                eval(ast, global_env)
            },
            Err(e) => println("Error reading file: " ++ e)
        }
    } else if cmd == "test" {
        println("Running full conformance suite...")
        let result = exec(["powershell", "-ExecutionPolicy", "Bypass", "-File", "tests/run_differential_tests.ps1"])
        match result {
            Ok(res) => println(res[1][1]),
            Err(e) => println("Error: " ++ e)
        }
    } else {
        println("Unknown command: " ++ cmd)
    }
}

// Since there is no 'include' directive in stage 0, 
// a real build step would concatenate these files or the host would load them.
// For now, this is the main entry point assuming they are combined.
main()
